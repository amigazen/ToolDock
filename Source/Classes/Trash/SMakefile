#
# SAS/C smake for DockTrash.class
# From src/Classes/Trash: smake
#
include ../../debug.defs

LIBNAME = DockTrash
LIBFILE = $(LIBNAME).class
LIBDIR = //$(DIR)/Gadgets/
FD_FILE = /template.fd
PRAGMA_FILE = pragmas.h

TRITON_INC = ////OpenTriton/SDK/Include_h
TRITON_LIB = ////OpenTriton/Source/lib/triton.lib

INC = INCLUDEDIRECTORY=///include INCLUDEDIRECTORY=/ INCLUDEDIRECTORY=$(TRITON_INC)
C_OPTS = CPU=$(CPU) $(SC_OPTS) NOSTANDARDIO $(INC) $(DEF_DS) $(DEF_BV)

OBJECTS = lib.o trash.o trash_move.o docktrash_cat.o
CLASS_LIBS = LIB:sc.lib LIB:amiga.lib $(TRITON_LIB)

all: $(LIBFILE)

$(LIBFILE): $(OBJECTS) $(PRAGMA_FILE)
	$(LINKER) WITH <<
TO $(LIBDIR)$(LIBFILE)
FROM $(OBJECTS)
LIB $(CLASS_LIBS) $(LD_OPTS)
<

.c.o:
	$(COMPILER) $(C_OPTS) $*.c

lib.o: lib.c /template.c
trash.o: trash.c trash_move.h
trash_move.o: trash_move.c trash_move.h
docktrash_cat.o: docktrash_cat.c

$(PRAGMA_FILE): $(FD_FILE)
	$(FD_CONV) $(FD_FILE) $(PRAGMA_FILE)

cleanobj:
	-Delete $(OBJECTS)

clean:
	-Delete $(OBJECTS)
	-Delete $(LIBDIR)$(LIBFILE)(|.info)
	-Delete $(PRAGMA_FILE)

reload:
	@copy $(LIBDIR)$(LIBFILE) LIBS:
	@version $(LIBFILE)
	@flushlibs
