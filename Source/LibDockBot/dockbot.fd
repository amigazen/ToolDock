* Dock gadget functions
TD_GetDockGadgetEnvironment(obj,env)(a0/a1)
TD_RequestDockQuit(obj)(a0)
TD_RequestDockGadgetDraw(obj)(a0)
TD_RequestLaunch(obj,path,args,console,wb)(a0/a1/a2/a3,d0)
* Drawing utilities
TD_DrawOutsetFrame(rp,bounds)(a0/a1)
TD_DrawInsetFrame(rp,bounds)(a0/a1)
* Settings functions
TD_OpenSettingsRead(filename)(a0)
TD_OpenSettingsWrite(filename)(a0)
TD_CloseSettings(settings)(a0)
TD_ReadBeginBlock(settings)(a0)
TD_ReadEndBlock(settings)(a0)
TD_ReadSetting(settings,value)(a0/a1)
TD_WriteBeginBlock(settings)(a0)
TD_WriteEndBlock(settings)(a0)
TD_WriteSetting(settings,key,value)(a0/a1/a2)
TD_ReadConfig(cfg,settings)(a0/a1)
TD_WriteConfig(cfg,settings)(a0/a1)
* Memory Management
TD_AllocMem(byteSize,attributes)(d0/d1)
TD_FreeMem(memoryBlock,byteSize)(a0,d0)
TD_GetMemInfo()
* Class Management
TD_CreateDockGadget(name)(a0)
TD_ListClasses(list)(a0)
* User Messages
TD_ShowError(message)(a0)
* Gadget Message Ports
TD_RegisterPort(obj,port) (a0/a1)
TD_UnregisterPort(obj,port) (a0,a1)
* Config cleanup
TD_DisposeConfig(cfg) (a0)
* More gadget stuff
TD_DisposeDockGadget(obj) (a0)
TD_FreeGadget(dg) (a0)
TD_AllocGadget(name) (a0)
* Debug Logging
TD_RegisterDebugStream(fh) (a0)
TD_DebugLog(fmt,argv) (a0/a1)
* Brushes
TD_LoadBrush(fileName,flags) (a0,d0)
TD_FreeBrush(brush) (a0)
TD_DrawBrush(brush,rp,srcX,srcY,dstX,dstY,w,h) (a0/a1,d0/d1/d2/d3/d4/d5)
TD_GetBrushSize(brush,w,h) (a0,a1,a2)
* File Requester
TD_SelectFile(title,okText,cancelText,path) (a0/a1/a2/a3)
* Dock icons (AppIcon mirror)
TD_AddDockIconA(id,userdata,text,msgport,lock,diskobj,taglist)(d0/d1/a0/a1/a2/a3/a4)
TD_RemoveDockIcon(icon)(a0)
TD_RedrawDockIcon(icon)(a0)
##end
