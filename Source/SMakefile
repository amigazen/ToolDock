#
# SAS/C smakefile for ToolDock. Run from Source directory: smake
#
# Nested smake stays here and only changes macros (see release).
# Per-module SMakefiles are for a shell cd into that directory.
#

COMPILER = sc
LINKER = slink
FD_CONV = sc:c/fd2pragma

CPU = 68030
DIR = /bin/debug

LIBS = LIB:sc.lib LIB:amiga.lib
SC_OPTS = NOICONS NOCHKABORT DEFINE=DEBUG_BUILD
LD_OPTS = NOICONS
DEF_BV = DEFINE=BUILDVER="1.11"
DEF_DS = DEFINE=DS="31.10.26"

ROADSHOW = netinclude:

TRITON = //OpenTriton
TRITON_INC = $(TRITON)/SDK/Include_h
TRITON_LIB = $(TRITON)/SDK/lib/triton.lib

# NDK 3.2 R4 lives next to github/ at the ToolBox root.
NDK_INC = ///NDK3.2R4/Include_H
PM_INC = //popupmenu.library/SDK/Include_H

LIB_OPTS = CPU=$(CPU) $(SC_OPTS) IDIR=/include IDIR=LibDockBot $(DEF_DS) $(DEF_BV)
MOTION_INC = //Motion/include
EXE_OPTS = CPU=$(CPU) $(SC_OPTS) IDIR=/include IDIR=shared IDIR=DockBot IDIR=$(NDK_INC) IDIR=$(MOTION_INC) IDIR=$(PM_INC) $(DEF_DS) $(DEF_BV)
PREFS_OPTS = CPU=$(CPU) $(SC_OPTS) IDIR=/include IDIR=shared IDIR=DockBotPrefs IDIR=$(TRITON_INC) $(DEF_DS) $(DEF_BV)
DOCK_OPTS = CPU=$(CPU) $(SC_OPTS) IDIR=/include IDIR=DockPrefs IDIR=$(NDK_INC) $(DEF_DS) $(DEF_BV)
BTN_OPTS = CPU=$(CPU) $(SC_OPTS) NOSTANDARDIO IDIR=/include IDIR=Classes IDIR=Classes/Button IDIR=DockBot IDIR=$(NDK_INC) IDIR=$(PM_INC) IDIR=$(TRITON_INC) $(DEF_DS) $(DEF_BV)
CLK_OPTS = CPU=$(CPU) $(SC_OPTS) NOSTANDARDIO IDIR=/include IDIR=Classes IDIR=Classes/Clock IDIR=$(TRITON_INC) $(DEF_DS) $(DEF_BV)
MEM_OPTS = CPU=$(CPU) $(SC_OPTS) NOSTANDARDIO IDIR=/include IDIR=Classes IDIR=Classes/Mem IDIR=$(TRITON_INC) $(DEF_DS) $(DEF_BV)
NET_OPTS = CPU=$(CPU) $(SC_OPTS) NOSTANDARDIO IDIR=/include IDIR=Classes IDIR=Classes/Net IDIR=$(ROADSHOW) IDIR=$(TRITON_INC) $(DEF_DS) $(DEF_BV)
SW_OPTS = CPU=$(CPU) $(SC_OPTS) NOSTANDARDIO IDIR=/include IDIR=Classes IDIR=Classes/Switcher IDIR=$(TRITON_INC) $(DEF_DS) $(DEF_BV)
EYES_OPTS = CPU=$(CPU) $(SC_OPTS) NOSTANDARDIO IDIR=/include IDIR=Classes IDIR=Classes/Eyes IDIR=$(TRITON_INC) $(DEF_DS) $(DEF_BV)
TRASH_OPTS = CPU=$(CPU) $(SC_OPTS) NOSTANDARDIO IDIR=/include IDIR=Classes IDIR=Classes/Trash IDIR=DockBot IDIR=$(NDK_INC) IDIR=$(PM_INC) IDIR=$(TRITON_INC) $(DEF_DS) $(DEF_BV)
OPEN_OPTS = CPU=$(CPU) $(SC_OPTS) NOSTANDARDIO IDIR=/include IDIR=Classes IDIR=Classes/Open IDIR=$(TRITON_INC) $(DEF_DS) $(DEF_BV)
EX_OPTS = CPU=$(CPU) $(SC_OPTS) NOSTANDARDIO IDIR=/include IDIR=Classes IDIR=Classes/Exchange IDIR=DockBot IDIR=$(NDK_INC) IDIR=$(PM_INC) IDIR=$(TRITON_INC) $(DEF_DS) $(DEF_BV)

CLASS_LIBS = LIB:sc.lib LIB:amiga.lib $(TRITON_LIB)
PREFS_LIBS = $(LIBS) $(TRITON_LIB)
DOCK_LIBS = $(LIBS) LIB:reaction.lib
EYES_LIBS = $(CLASS_LIBS) LIB:scm.lib

LIB_OBJS = LibDockBot/lib.o LibDockBot/gfx.o LibDockBot/gadget.o \
 LibDockBot/settings.o LibDockBot/memory.o LibDockBot/dock_gadget.o \
 LibDockBot/classes.o LibDockBot/req.o LibDockBot/debug.o

EXE_OBJS = DockBot/main.o DockBot/dock.o DockBot/dockbot_cat.o \
 shared/dock_gadget.o DockBot/dock_handle.o DockBot/events.o \
 DockBot/gadgets.o DockBot/layout.o DockBot/settings.o \
 DockBot/debug.o DockBot/window.o \
 DockBot/cx.o DockBot/appicon.o DockBot/timer.o DockBot/rearrange.o \
 DockBot/dropzone.o DockBot/applife.o

PREFS_OBJS = DockBotPrefs/main.o DockBotPrefs/dockbotprefs_cat.o \
 shared/dock_gadget.o DockBotPrefs/settings.o \
 DockBotPrefs/new_gadget.o DockBotPrefs/gadget_list.o \
 DockBotPrefs/tags.o

DOCK_OBJS = DockPrefs/main.o DockPrefs/dock_cat.o DockPrefs/settings.o \
 DockPrefs/new_gadget.o DockPrefs/gadget_list.o DockPrefs/editor.o \
 DockPrefs/classes.o DockPrefs/gadgets.o

BTN_CLASS_OBJS = Classes/Button/lib.o Classes/Button/button.o \
 Classes/Button/triton_icon.o Classes/Button/dockbutton_cat.o
BTN_OBJS = $(BTN_CLASS_OBJS) DockBot/applife.o

CLK_OBJS = Classes/Clock/lib.o Classes/Clock/clock.o Classes/Clock/dockclock_cat.o

MEM_OBJS = Classes/Mem/lib.o Classes/Mem/mem.o Classes/Mem/dockmem_cat.o

NET_OBJS = Classes/Net/lib.o Classes/Net/net.o Classes/Net/docknet_cat.o

SW_OBJS = Classes/Switcher/lib.o Classes/Switcher/switcher.o \
 Classes/Switcher/prefs.o Classes/Switcher/window_list.o \
 Classes/Switcher/switcher_cat.o

EYES_OBJS = Classes/Eyes/lib.o Classes/Eyes/eyes.o Classes/Eyes/eyes_cat.o

TRASH_CLASS_OBJS = Classes/Trash/lib.o Classes/Trash/trash.o Classes/Trash/trash_move.o \
 Classes/Trash/docktrash_cat.o
TRASH_OBJS = $(TRASH_CLASS_OBJS) DockBot/applife.o

OPEN_OBJS = Classes/Open/lib.o Classes/Open/open.o Classes/Open/open_item.o \
 Classes/Open/dockopen_cat.o

EX_CLASS_OBJS = Classes/Exchange/lib.o Classes/Exchange/exchange.o \
 Classes/Exchange/dockexchange_cat.o
EX_OBJS = $(EX_CLASS_OBJS) DockBot/applife.o

#-----------------------------------------------------------------------------

.c.o:
	@echo "        Compiling $*.c..."
	@sc $(SC_OPTS) $*.c to $*.o

.h.h:

#-----------------------------------------------------------------------------

all: lib
all: exe
all: prefs
all: dock
all: button
all: clock
all: mem
all: switcher
all: eyes
all: trash
all: open
all: exchange
all: catalogs

lib: $(DIR)/tooldock.library
exe: $(DIR)/ToolDock
